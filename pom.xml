        <dependency>
            <groupId>dev.dejvokep</groupId>
            <artifactId>boosted-yaml</artifactId>
            <version>1.3.6</version>
        </dependency>

        <!-- JvmDowngrader CLI 可执行包，maven自动下载，不需要手动拿release -->
        <dependency>
            <groupId>xyz.wagyourtail.jvmdowngrader</groupId>
            <artifactId>jvmdowngrader</artifactId>
            <version>${jvmdg.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Java8 对应的api‑stub依赖 -->
        <dependency>
            <groupId>xyz.wagyourtail.jvmdowngrader</groupId>
            <artifactId>jvmdowngrader-java-api</artifactId>
            <version>${jvmdg.version}</version>
            <classifier>downgraded-8</classifier>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
