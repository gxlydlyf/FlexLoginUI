<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gxlydlyf</groupId>
    <artifactId>flexloginui</artifactId>
    <version>1.3.1-beta</version>
    <packaging>jar</packaging>

    <name>FlexLoginUI</name>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <jvmdg.version>2.0.1</jvmdg.version>
    </properties>
    <url>https://github.com/gxlydlyf/FlexLoginUI</url>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/gxlydlyf/FlexLoginUI</url>
        </repository>
    </distributionManagement>

    <pluginRepositories>
        <pluginRepository>
            <id>wagyourtail-releases</id>
            <url>https://maven.wagyourtail.xyz/releases</url>
        </pluginRepository>
        <pluginRepository>
            <id>wagyourtail-snapshots</id>
            <url>https://maven.wagyourtail.xyz/snapshots</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <release>${maven.compiler.target}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <relocations>
                        <relocation>
                            <pattern>dev.dejvokep.boostedyaml</pattern>
                            <shadedPattern>com.gxlydlyf.flexloginui.dev.dejvokep.boostedyaml</shadedPattern>
                        </relocation>
                    </relocations>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.MF</exclude>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                        <filter>
                            <artifact>dev.dejvokep:boosted-yaml</artifact>
                            <excludes>
                                <exclude>LICENSE</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 下载降级CLI工具 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>fetch‑jvmdg‑cli</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>xyz.wagyourtail.jvmdowngrader</groupId>
                                    <artifactId>jvmdowngrader</artifactId>
                                    <version>${jvmdg.version}</version>
                                    <classifier>all</classifier>
                                    <destFileName>jvmdowngrader-cli-all.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- 第一步：字节码降级 -->
                    <execution>
                        <id>downgrade</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java jar="${project.build.directory}/jvmdowngrader-cli-all.jar"
                                      fork="true"
                                      failonerror="true"
                                      dir="${project.build.directory}">
                                    <arg value="-c"/>
                                    <arg value="52"/>
                                    <arg value="downgrade"/>
                                    <arg value="-t"/>
                                    <arg value="${project.artifactId}-${project.version}.jar"/>
                                    <arg value="temp-downgrade.jar"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <!-- 第二步：内嵌 API stub -->
                    <execution>
                        <id>shade-api</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java jar="${project.build.directory}/jvmdowngrader-cli-all.jar"
                                      fork="true"
                                      failonerror="true"
                                      dir="${project.build.directory}">
                                    <arg value="-c"/>
                                    <arg value="52"/>
                                    <arg value="shade"/>
                                    <arg value="-p"/>
                                    <arg value="com/gxlydlyf/flexloginui"/>
                                    <arg value="-t"/>
                                    <arg value="temp-downgrade.jar"/>
                                    <arg value="${project.artifactId}-${project.version}-downgraded.jar"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>opencollab-snapshot</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <repository>
            <id>viaversion-repo</id>
            <url>https://repo.viaversion.com</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/public/</url>
        </repository>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>wagyourtail-releases</id>
            <url>https://maven.wagyourtail.xyz/releases</url>
        </repository>
        <repository>
            <id>wagyourtail-snapshots</id>
            <url>https://maven.wagyourtail.xyz/snapshots</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <dependencies>
        <!--        <dependency>-->
        <!--            <groupId>com.destroystokyo.paper</groupId>-->
        <!--            <artifactId>paper-api</artifactId>-->
        <!--            <version>1.13-R0.1-SNAPSHOT</version>-->
        <!--            <scope>provided</scope>-->
        <!--        </dependency>-->
        <!--suppress VulnerableLibrariesLocal -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.13-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.retrooper</groupId>
